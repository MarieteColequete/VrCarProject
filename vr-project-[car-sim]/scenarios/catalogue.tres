scenarios = Array[ExtResource("definition")]([ExtResource("stop_junction"), ExtResource("traffic_lights"), ExtResource("pedestrian_crossing"), ExtResource("lane_change_overtake"), ExtResource("give_way_junction"), ExtResource("roundabout"), ExtResource("bay_parking"), ExtResource("parallel_parking")])

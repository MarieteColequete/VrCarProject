[sub_resource type="BoxMesh" id="Mesh_parked"]
size = Vector3(1.8, 1.4, 4.2)

[sub_resource type="StandardMaterial3D" id="Material_parked"]
albedo_color = Color(0.7, 0.2, 0.15, 1)

[sub_resource type="Environment" id="Environment_sky"]

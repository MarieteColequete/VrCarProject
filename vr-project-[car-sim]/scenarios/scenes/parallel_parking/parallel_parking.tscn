[node name="ParallelParking" type="Node3D" node_paths=PackedStringArray("spawn_point")]
script = ExtResource("scenario")
definition = SubResource("Definition")
spawn_point = NodePath("SpawnPoint")

[node name="Sun" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.8660254, -0.35355338, 0.35355338, 0, 0.70710677, 0.70710677, -0.5, -0.61237246, 0.61237246, 0, 20, 0)
shadow_enabled = true

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_sky")

[node name="Ground" type="StaticBody3D" parent="."]

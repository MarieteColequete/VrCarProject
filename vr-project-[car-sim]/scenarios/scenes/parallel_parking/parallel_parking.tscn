[gd_scene format=3]

[ext_resource type="PackedScene" path="res://scenarios/kit/map_scenario_base.tscn" id="base"]

[ext_resource type="PackedScene" path="res://maps/parallel_parking/parallel_parking.tscn" id="map"]

[ext_resource type="Resource" path="res://scenarios/scenes/parallel_parking/definition.tres" id="definition"]

[ext_resource type="Script" path="res://scenarios/core/scenario_step.gd" id="step"]

[ext_resource type="Script" path="res://scenarios/checks/parking_check.gd" id="parking"]

[ext_resource type="Script" path="res://scenarios/checks/parking_choice_check.gd" id="choice"]

[node name="ParallelParking" node_paths=PackedStringArray("map") instance=ExtResource("base")]
definition = ExtResource("definition")
map = NodePath("Map")

[node name="Map" parent="." instance=ExtResource("map")]

[node name="Steps" type="Node" parent="."]

[node name="Park" type="Node" parent="Steps"]
script = ExtResource("step")
title = "Park in the gap"
instruction = "Park in the gap between the two parked cars, parallel to the kerb."

[node name="ParkingCheck" type="Node3D" parent="Checks" node_paths=PackedStringArray("step", "active_steps")]
script = ExtResource("parking")
step = NodePath("../../Steps/Park")
active_steps = [NodePath("../../Steps/Park")]
max_direction_changes = 3
time_limit = 0.0

[node name="ParkingChoiceCheck" type="Node3D" parent="Checks" node_paths=PackedStringArray("active_steps")]
script = ExtResource("choice")
active_steps = [NodePath("../../Steps/Park")]

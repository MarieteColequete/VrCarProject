[sub_resource type="Resource" id="Definition"]
script = ExtResource("definition")
title = "Parallel parking"
briefing = "Drive along the street and park in the gap between the two parked cars, close to the kerb. The kerb before the cars has a no-parking line."
time_limit = 120.0
policy = ExtResource("policy")
car_scene = ExtResource("car")


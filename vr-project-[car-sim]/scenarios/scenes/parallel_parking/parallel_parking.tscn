[node name="Checks" type="Node3D" parent="."]

[node name="ParkingCheck" type="Node3D" parent="Checks" node_paths=PackedStringArray("step", "active_steps")]
script = ExtResource("parking")
step = NodePath("../../Steps/Park")
active_steps = [NodePath("../../Steps/Park")]
max_direction_changes = 3
time_limit = 0.0
overhang_minor_fault = ExtResource("f_parking_overhang_minor")
overhang_serious_fault = ExtResource("f_parking_overhang_serious")
misaligned_fault = ExtResource("f_parking_misaligned")
manoeuvres_fault = ExtResource("f_parking_too_many_manoeuvres")
too_slow_fault = ExtResource("f_parking_too_slow")

[node name="ParkingChoiceCheck" type="Node3D" parent="Checks" node_paths=PackedStringArray("active_steps")]
script = ExtResource("choice")
active_steps = [NodePath("../../Steps/Park")]
illegal_fault = ExtResource("f_parking_illegal")
reserved_fault = ExtResource("f_parking_reserved")
occupied_fault = ExtResource("f_parking_occupied")

[node name="ContactCheck" type="Node3D" parent="Checks"]
script = ExtResource("contact")
obstacle_fault = ExtResource("f_contact_obstacle")
pedestrian_fault = ExtResource("f_contact_pedestrian")

[node name="LineCheck" type="Node3D" parent="Checks"]
script = ExtResource("lines")
solid_fault = ExtResource("f_line_solid_crossed")
no_indicator_fault = ExtResource("f_no_indicator")
straddle_fault = ExtResource("f_line_straddled")
kerb_fault = ExtResource("f_kerb_mounted")

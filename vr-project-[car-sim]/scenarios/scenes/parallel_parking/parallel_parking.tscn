[sub_resource type="Resource" id="Definition"]
script = ExtResource("definition")
title = "Parallel parking"
briefing = "Drive along the street and park in the gap between the two parked cars, close to the kerb. The kerb before the cars has a no-parking line."
time_limit = 120.0
policy = ExtResource("policy")
car_scene = ExtResource("car")

[sub_resource type="BoxShape3D" id="Shape_ground"]
size = Vector3(60, 0.2, 90)

[sub_resource type="PlaneMesh" id="Mesh_ground"]
size = Vector2(60, 90)

[sub_resource type="StandardMaterial3D" id="Material_ground"]
albedo_color = Color(0.3, 0.5, 0.25, 1)

[sub_resource type="BoxMesh" id="Mesh_road"]
size = Vector3(9.3, 0.02, 80)

[sub_resource type="StandardMaterial3D" id="Material_asphalt"]

[sub_resource type="Resource" id="Definition"]
script = ExtResource("definition")
title = "Give way junction"
briefing = "Drive to the end of the road and turn right onto the main road. Give way to the traffic on the main road, and go when there is a safe gap."
time_limit = 120.0
policy = ExtResource("policy")
car_scene = ExtResource("car")


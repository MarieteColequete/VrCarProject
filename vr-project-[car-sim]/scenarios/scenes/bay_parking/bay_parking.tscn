[sub_resource type="Resource" id="Definition"]
script = ExtResource("definition")
title = "Bay parking"
briefing = "Drive into the car park and reverse into a free bay. Bays with a car in them are taken, the yellow bay is reserved, and the end of the aisle is a fire lane."
time_limit = 120.0
policy = ExtResource("policy")
car_scene = ExtResource("car")

[sub_resource type="BoxShape3D" id="Shape_ground"]
size = Vector3(60, 0.2, 80)

[sub_resource type="PlaneMesh" id="Mesh_ground"]

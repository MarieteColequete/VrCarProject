[gd_resource type="Resource" script_class="ScenarioDefinition" format=3]

[ext_resource type="Script" path="res://scenarios/data/scenario_definition.gd" id="script"]

[resource]
script = ExtResource("script")
id = &"busy_junction"
title = "Busy junction"
category = "Traffic"
difficulty = 3
briefing = "Drive along the main road in the left lane, through the traffic lights and over the pedestrian crossing, to the end of the road. Other road users react to how you drive: keep to the lights, give way at the crossing, and do not force anyone to brake hard."
time_limit = 150.0
scene_path = "res://scenarios/scenes/busy_junction/busy_junction.tscn"

[gd_resource type="Resource" script_class="ScenarioDefinition" format=3]

[ext_resource type="Script" path="res://scenarios/data/scenario_definition.gd" id="script"]

[resource]
script = ExtResource("script")
id = &"lane_change_overtake"
title = "Lane change and overtaking"
category = "Lane discipline"
difficulty = 2
briefing = "A slow vehicle is ahead. Keep a safe distance, and overtake only where the centre line is dashed: check the mirror and over the shoulder, and indicate, before pulling out and before moving back in."
time_limit = 120.0
scene_path = "res://scenarios/scenes/lane_change_overtake/lane_change_overtake.tscn"

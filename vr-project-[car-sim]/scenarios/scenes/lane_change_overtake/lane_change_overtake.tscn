[node name="SlowPath" type="Path3D" parent="."]
curve = SubResource("Curve_Slow")

[node name="SlowVehicle" type="AnimatableBody3D" parent="." node_paths=PackedStringArray("path")]
script = ExtResource("agent")
path = NodePath("../SlowPath")
speed = 4.0

[node name="LineCheck" type="Node3D" parent="."]
script = ExtResource("lines")
solid_fault = ExtResource("f_line_solid_crossed")
no_indicator_fault = ExtResource("f_no_indicator")
straddle_fault = ExtResource("f_line_straddled")
kerb_fault = ExtResource("f_kerb_mounted")

[node name="GazeCheck" type="Node3D" parent="."]
script = ExtResource("gaze")
mirror_fault = ExtResource("f_no_mirror_check")
shoulder_fault = ExtResource("f_no_shoulder_check")

[node name="FollowingDistanceCheck" type="Node3D" parent="." node_paths=PackedStringArray("agents")]
script = ExtResource("following")
agents = [NodePath("../SlowVehicle")]
fault = ExtResource("f_following_too_close")

[node name="ContactCheck" type="Node3D" parent="."]
script = ExtResource("contact")
obstacle_fault = ExtResource("f_contact_obstacle")
pedestrian_fault = ExtResource("f_contact_pedestrian")

[node name="GoalCheck" type="Node3D" parent="." node_paths=PackedStringArray("zone")]
script = ExtResource("goal")
zone = NodePath("Zone")

[node name="Zone" type="Area3D" parent="GoalCheck"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1.75, 1.5, -190)
script = ExtResource("zone")

[node name="CollisionShape3D" type="CollisionShape3D" parent="GoalCheck/Zone"]

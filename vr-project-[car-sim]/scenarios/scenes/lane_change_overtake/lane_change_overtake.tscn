[sub_resource type="Resource" id="Definition"]
script = ExtResource("definition")
title = "Lane change and overtaking"
briefing = "A slow vehicle is ahead. Keep a safe distance, and overtake only where the centre line is dashed: check the mirror and over the shoulder, and indicate, before pulling out and before moving back in."
time_limit = 120.0
policy = ExtResource("policy")
car_scene = ExtResource("car")

[sub_resource type="Environment" id="Environment_sky"]
background_mode = 1
background_color = Color(0.55, 0.7, 0.85, 1)
ambient_light_source = 2

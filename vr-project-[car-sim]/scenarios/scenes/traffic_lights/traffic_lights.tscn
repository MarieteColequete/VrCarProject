[sub_resource type="Resource" id="Definition"]
script = ExtResource("definition")
title = "Traffic lights"
briefing = "Drive along the road at up to 50 km/h through two sets of traffic lights. Stop for red, and for amber when you can stop safely."
time_limit = 120.0
policy = ExtResource("policy")
car_scene = ExtResource("car")


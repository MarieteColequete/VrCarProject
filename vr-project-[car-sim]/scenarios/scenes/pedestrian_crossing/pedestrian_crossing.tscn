dash_length = 0.5
gap_length = 0.5

[node name="WalkPath" type="Path3D" parent="."]
curve = SubResource("Curve_Walk")

[node name="WalkTrigger" type="Area3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.5, 41.5)
script = ExtResource("zone")

[node name="CollisionShape3D" type="CollisionShape3D" parent="WalkTrigger"]
shape = SubResource("Shape_trigger")

[node name="Walker" type="AnimatableBody3D" parent="." node_paths=PackedStringArray("path", "trigger")]
script = ExtResource("agent")
path = NodePath("../WalkPath")
speed = 1.4
trigger = NodePath("../WalkTrigger")
pedestrian = true
body_size = Vector3(0.5, 1.8, 0.5)
colour = Color(0.2, 0.6, 0.9, 1)

[node name="BusyZebraCheck" type="Node3D" parent="." node_paths=PackedStringArray("crossing_zone", "pedestrians")]
script = ExtResource("crossing")
crossing_zone = NodePath("Zone")
pedestrians = [NodePath("../Walker")]
give_way_fault = ExtResource("f_crossing_not_given_way")
stopped_on_fault = ExtResource("f_crossing_stopped_on")

[node name="Zone" type="Area3D" parent="BusyZebraCheck"]

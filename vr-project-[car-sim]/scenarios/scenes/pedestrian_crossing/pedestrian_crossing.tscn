[sub_resource type="Resource" id="Definition"]
script = ExtResource("definition")
title = "Pedestrian crossing"
briefing = "Drive along the road over two pedestrian crossings. Give way to anyone crossing or waiting to cross, and do not stop on a crossing."
time_limit = 90.0
policy = ExtResource("policy")
car_scene = ExtResource("car")

[sub_resource type="Environment" id="Environment_sky"]
background_mode = 1
background_color = Color(0.55, 0.7, 0.85, 1)
ambient_light_source = 2
ambient_light_color = Color(0.8, 0.8, 0.85, 1)

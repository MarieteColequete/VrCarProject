[node name="Road" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.01, -25)
mesh = SubResource("Mesh_road")
surface_material_override/0 = SubResource("Material_asphalt")

[node name="SpawnPoint" type="Marker3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 1.75, 0, 60)

[node name="Markings" type="Node3D" parent="."]

[node name="CentreLine" type="Path3D" parent="Markings"]

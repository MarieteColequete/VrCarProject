[gd_resource type="Resource" script_class="AssetPack" format=3 uid="uid://cj7ky73v5by8b"]

[ext_resource type="Script" uid="uid://blsq3hsw7vywm" path="res://scenarios/data/asset_category.gd" id="category"]
[ext_resource type="Script" uid="uid://c01e3sbfnk77t" path="res://scenarios/data/asset_pack.gd" id="pack"]
[ext_resource type="Resource" path="res://scenarios/data/body_types/vehicle.tres" id="vehicle"]

[sub_resource type="Resource" id="locomotives"]
script = ExtResource("category")
title = "Locomotives"
models = PackedStringArray("train-locomotive-*", "train-diesel-*")
body = ExtResource("vehicle")
order = 70

[sub_resource type="Resource" id="electric"]
script = ExtResource("category")
title = "Electric trains"
models = PackedStringArray("train-electric-*")
body = ExtResource("vehicle")
order = 71

[sub_resource type="Resource" id="trams"]
script = ExtResource("category")
title = "Trams"
models = PackedStringArray("train-tram-*")
body = ExtResource("vehicle")
order = 72

[sub_resource type="Resource" id="carriages"]
script = ExtResource("category")
title = "Wagons"
models = PackedStringArray("train-carriage-*")
body = ExtResource("vehicle")
order = 73

[sub_resource type="Resource" id="couplers"]
script = ExtResource("category")
title = "Couplers"
models = PackedStringArray("train-connector")
order = 74

[sub_resource type="Resource" id="track"]
script = ExtResource("category")
title = "Railway track"
models = PackedStringArray("railroad-*", "track*", "spline-*")
order = 75

[resource]
script = ExtResource("pack")
title = "Train Kit"
tag = "Trains"
credit = "Kenney (kenney.nl), CC0"
scale = 2.5
categories = Array[ExtResource("category")]([SubResource("locomotives"), SubResource("electric"), SubResource("trams"), SubResource("carriages"), SubResource("couplers"), SubResource("track")])

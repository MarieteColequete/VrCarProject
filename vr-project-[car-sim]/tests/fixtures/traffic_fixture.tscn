[sub_resource type="Resource" id="Definition"]
script = ExtResource("2_definition")
title = "Traffic fixture"
briefing = "A straight road with a pedestrian who starts crossing as the car approaches."
time_limit = 60.0
policy = ExtResource("3_policy")
car_scene = ExtResource("4_car")

[sub_resource type="BoxShape3D" id="Shape_ground"]

[gd_scene format=3]

[ext_resource type="Script" path="res://scenarios/core/scenario.gd" id="1_scenario"]
[ext_resource type="Script" path="res://scenarios/data/scenario_definition.gd" id="2_definition"]
[ext_resource type="Resource" path="res://scenarios/data/default_policy.tres" id="3_policy"]
[ext_resource type="PackedScene" path="res://scenarios/scenes/player_car.tscn" id="4_car"]
[ext_resource type="Script" path="res://scenarios/core/scenario_step.gd" id="5_step"]
[ext_resource type="Script" path="res://scenarios/checks/trigger_zone.gd" id="6_zone"]
[ext_resource type="Script" path="res://scenarios/checks/goal_check.gd" id="7_goal"]
[ext_resource type="Script" path="res://scenarios/checks/speed_limit_check.gd" id="8_speed"]

[sub_resource type="Resource" id="Definition"]
script = ExtResource("2_definition")
title = "Steps fixture"
briefing = "Drive to the first marker, then to the second, keeping to 10 km/h after the first."
time_limit = 60.0
policy = ExtResource("3_policy")
car_scene = ExtResource("4_car")

[sub_resource type="BoxShape3D" id="Shape_ground"]
size = Vector3(100, 0.2, 100)

[sub_resource type="BoxShape3D" id="Shape_goal"]
size = Vector3(8, 3, 4)

[sub_resource type="BoxShape3D" id="Shape_speed"]
size = Vector3(8, 3, 60)

[node name="StepsFixture" type="Node3D" node_paths=PackedStringArray("spawn_point")]
script = ExtResource("1_scenario")
definition = SubResource("Definition")
spawn_point = NodePath("SpawnPoint")

[node name="Ground" type="StaticBody3D" parent="."]

[node name="CollisionShape3D" type="CollisionShape3D" parent="Ground"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.1, -20)
shape = SubResource("Shape_ground")

[node name="SpawnPoint" type="Marker3D" parent="."]

[node name="Steps" type="Node" parent="."]

[node name="ReachFirst" type="Node" parent="Steps"]
script = ExtResource("5_step")
title = "Reach the first marker"

[node name="ReachSecond" type="Node" parent="Steps"]
script = ExtResource("5_step")
title = "Reach the second marker at 10 km/h"

[node name="FirstGoal" type="Node3D" parent="." node_paths=PackedStringArray("zone", "step")]
script = ExtResource("7_goal")
zone = NodePath("Zone")
step = NodePath("../Steps/ReachFirst")

[node name="Zone" type="Area3D" parent="FirstGoal"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.5, -20)
script = ExtResource("6_zone")

[node name="CollisionShape3D" type="CollisionShape3D" parent="FirstGoal/Zone"]
shape = SubResource("Shape_goal")

[node name="SecondGoal" type="Node3D" parent="." node_paths=PackedStringArray("zone", "step")]
script = ExtResource("7_goal")
zone = NodePath("Zone")
step = NodePath("../Steps/ReachSecond")

[node name="Zone" type="Area3D" parent="SecondGoal"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.5, -45)
script = ExtResource("6_zone")

[node name="CollisionShape3D" type="CollisionShape3D" parent="SecondGoal/Zone"]
shape = SubResource("Shape_goal")

[node name="SpeedInSecondStep" type="Node3D" parent="." node_paths=PackedStringArray("zone", "active_steps")]
script = ExtResource("8_speed")
zone = NodePath("Zone")
limit_kmh = 10.0
active_steps = [NodePath("../Steps/ReachSecond")]

[node name="Zone" type="Area3D" parent="SpeedInSecondStep"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.5, -25)
script = ExtResource("6_zone")

[node name="CollisionShape3D" type="CollisionShape3D" parent="SpeedInSecondStep/Zone"]
shape = SubResource("Shape_speed")

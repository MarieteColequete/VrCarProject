    "hooks": {
      "ConfigChange": [
        {
          "hooks": [
            {
              "args": [
                "${CLAUDE_PROJECT_DIR}/.claude/bin/preset",
                "hook",
                "config-change"
              ],
              "command": "sh",
              "timeout": 10,
              "type": "command"
            }
          ]
        }
      ],
      "InstructionsLoaded": [
        {
          "hooks": [
            {
              "args": [
                "${CLAUDE_PROJECT_DIR}/.claude/bin/preset",
                "hook",
                "instructions-loaded"
              ],
              "command": "sh",
              "timeout": 10,
              "type": "command"
            }
          ]
        }
      ],
      "PermissionDenied": [
        {
          "hooks": [
            {
              "args": [
                "${CLAUDE_PROJECT_DIR}/.claude/bin/preset",
                "hook",
                "permission-denied"
              ],
              "command": "sh",
              "timeout": 10,
              "type": "command"
            }
          ]
        }
      ],
      "PostToolUse": [
        {
          "hooks": [
            {
              "args": [
                "${CLAUDE_PROJECT_DIR}/.claude/bin/preset",
                "hook",
                "dashes"
              ],
              "command": "sh",
              "if": "Edit(*.md)",
              "timeout": 10,
              "type": "command"
            }
          ],
          "matcher": "Write|Edit|MultiEdit"
        }
      ],
      "PreToolUse": [
        {
          "hooks": [
            {
              "args": [
                "${CLAUDE_PROJECT_DIR}/.claude/bin/preset",
                "hook",
                "guard"
              ],
              "command": "sh",
              "onFailure": "block",
              "timeout": 10,
              "type": "command"
            }
          ],
          "matcher": "Bash|PowerShell"
        },
        {
          "hooks": [
            {
              "args": [
                "${CLAUDE_PROJECT_DIR}/.claude/bin/preset",
                "hook",
                "dashes"
              ],
              "command": "sh",
              "timeout": 10,
              "type": "command"
            }
          ],
          "matcher": "Write|Edit|MultiEdit"
        }
      ],
      "SessionStart": [
        {
          "hooks": [
            {
              "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/bin/preset\" self-check >/dev/null 2>&1 && sh \"${CLAUDE_PROJECT_DIR}/.claude/bin/preset\" hook session-start || echo '{\"systemMessage\": \"Agent configuration: the preset tool (.claude/bin/preset) does not run here or git is missing, so Bash and PowerShell commands are blocked and the writing checks and the stop gate do not run in this session.\", \"hookSpecificOutput\": {\"hookEventName\": \"SessionStart\", \"additionalContext\": \"The preset checks cannot run in this session: the preset tool (.claude/bin/preset) has no build that runs on this platform, or git is not on PATH. Without the command guard every Bash and PowerShell command is blocked until the author fixes it; the dash checks and the stop gate do not run either. Report this to the author instead of working around it.\"}}'",
              "timeout": 10,
              "type": "command"
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "args": [
                "${CLAUDE_PROJECT_DIR}/.claude/bin/preset",
                "hook",
                "stop"
              ],
              "asyncRewake": true,
              "command": "sh",
              "timeout": 900,
              "type": "command"
            }
          ]
        }
      ]
    },

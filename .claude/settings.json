    "deny": [
      "Bash(git *--no-gpg-sign*)",
      "Bash(git *commit.gpgsign=false*)",
      "Bash(git *commit.gpgSign=false*)",
      "Bash(git config *gpgsign false*)",
      "Bash(git config *gpgSign false*)",
      "Bash(git *--no-verify*)",
      "Bash(git push * dev)",
      "Bash(git push * main)",
      "Bash(git push *:dev)",
      "Bash(git push *:main)",
      "PowerShell(git *--no-gpg-sign*)",
      "PowerShell(git *commit.gpgsign=false*)",
      "PowerShell(git *commit.gpgSign=false*)",
      "PowerShell(git config *gpgsign false*)",
      "PowerShell(git config *gpgSign false*)",
      "PowerShell(git *--no-verify*)",
      "PowerShell(git push * dev)",
      "PowerShell(git push * main)",
      "PowerShell(git push *:dev)",
      "PowerShell(git push *:main)",
      "Edit(*.pdf)",
      "Edit(*.odt)",
      "Edit(*.docx)",
      "Edit(*.pptx)",
      "Edit(*.xlsx)"
    ],
    "blockWritesOutsideWorkingDirectories": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/bin/preset\" self-check >/dev/null 2>&1 && sh \"${CLAUDE_PROJECT_DIR}/.claude/bin/preset\" hook session-start || echo '{\"systemMessage\": \"Agent configuration: the preset tool (.claude/bin/preset) does not run here or git is missing, so Bash and PowerShell commands are blocked and the writing checks and the stop gate do not run in this session.\", \"hookSpecificOutput\": {\"hookEventName\": \"SessionStart\", \"additionalContext\": \"The preset checks cannot run in this session: the preset tool (.claude/bin/preset) has no build that runs on this platform, or git is not on PATH. Without the command guard every Bash and PowerShell command is blocked until the author fixes it; the dash checks and the stop gate do not run either. Report this to the author instead of working around it.\"}}'",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/bin/preset",
              "hook",
              "guard"
            ],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/bin/preset",
              "hook",
              "dashes"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(*.md)",
            "command": "sh",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/bin/preset",
              "hook",
              "dashes"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/bin/preset",
              "hook",
              "stop"
            ],
            "timeout": 900,
            "asyncRewake": true
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/bin/preset",
              "hook",
              "config-change"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/bin/preset",
              "hook",
              "permission-denied"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/bin/preset",
              "hook",
              "instructions-loaded"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
